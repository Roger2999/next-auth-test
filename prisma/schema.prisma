generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma/"
}

datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification")
}

enum ManagementType {
  CREATE
  UPDATE
  MODIFICATION
}

enum EmployeeType {
  EXECUTIVE
  SENIOR_SPECIALIST
  TECHNICIAN
  OTHER
}

enum AccountType {
  PERMANENT
  TEMPORARY
}

enum CloudAccessLevel {
  READ_ONLY
  MODIFY
  DELETE
  FULL_CONTROL
}


model UserAccountRequest {
  id              String         @id @default(cuid())
  
  folio           String         @unique
  requestDate     DateTime       @default(now())
  managementType  ManagementType
  
  fullName        String
  phoneExtension  String?
  position        String?
  department      String?
  employeeType    EmployeeType
  accountIdentifier String?      @unique

  nationalEmail   Boolean        @default(false)
  internationalEmail Boolean     @default(false)
  internetEmail   Boolean        @default(false)
  emailReason     String?

  uneIntranet     Boolean        @default(false)
  nationalIntranet Boolean       @default(false)
  internetAccess  Boolean        @default(false)
  webReason       String?

  corporateMessaging Boolean     @default(false)
  messagingReason String?

  facebook        Boolean        @default(false)
  twitter         Boolean        @default(false)
  youtube         Boolean        @default(false)
  whatsapp        Boolean        @default(false)
  telegram        Boolean        @default(false)
  instagram       Boolean        @default(false)
  otherSocialNetworks String?
  socialReason    String?

  basicUser       Boolean        @default(false)
  advancedUser    Boolean        @default(false)
  localAdmin      Boolean        @default(false)
  networkAdmin    Boolean        @default(false)
  privilegesReason String?

  cloudAccessLevel CloudAccessLevel?
  cloudReason     String?

  accountType     AccountType
  expirationDate  DateTime?

  weekdays        Boolean        @default(false)
  afterHours      Boolean        @default(false)
  afterHoursStart String?
  afterHoursEnd   String?
  saturday        Boolean        @default(false)
  saturdayStart   String?
  saturdayEnd     String?
  sunday          Boolean        @default(false)
  sundayStart     String?
  sundayEnd       String?
  twentyFourHours Boolean        @default(false)

  apnNationalEmail Boolean       @default(false)
  apnInternationalEmail Boolean  @default(false)
  apnInternet     Boolean        @default(false)
  apnCellularNumber Boolean      @default(false)

  authorizedPcName String?
  authenticationPcs String?
  authorizedSoftware String?

  requestedByName String?
  requestedByRole String?
  requestedByDate DateTime?
  requestedBySignature String?   

  reviewedByName  String?
  reviewedByRole  String?
  reviewedByDate  DateTime?
  reviewedBySignature String?

  approvedByName  String?
  approvedByRole  String?
  approvedByDate  DateTime?
  approvedBySignature String?

  executedByName  String?
  executedByRole  String?
  executedByDate  DateTime?
  executedBySignature String?

  isDeactivated   Boolean        @default(false)
  deactivationReason String?
  deactivationDate DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([folio])
  @@index([managementType])
  @@index([employeeType])
  @@index([accountType])
  @@index([isDeactivated])
  
  @@map("network_account_request")
}